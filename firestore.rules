rules_version = '2';

// Nothing is stored here, and nothing may be.
//
// This project once kept a count of how many devices used the app: one
// document per anonymous browser, one field holding a date. That has been
// removed. The app no longer writes anything anywhere, so there is no reason
// for any path in this database to be writable, and every one of them is
// closed.
//
// The file is kept, rather than deleted, precisely so that a deploy publishes
// this. Removing it would leave the older and more permissive rules live on a
// database nothing is watching, which is the worse of the two outcomes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
