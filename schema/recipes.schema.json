{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sherifhanna700.github.io/canotto-lab/schema/recipes.schema.json",
  "title": "Canotto recipe library",
  "description": "A set of recipes: the file the app writes from Recipe, Download all. A single recipe is written on its own against recipe.schema.json instead.",
  "allOf": [
    {
      "$ref": "https://sherifhanna700.github.io/canotto-lab/schema/common.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://sherifhanna700.github.io/canotto-lab/schema/recipes.schema.json"
        },
        "recipes": {
          "type": "array",
          "items": {
            "$ref": "https://sherifhanna700.github.io/canotto-lab/schema/recipe.schema.json"
          }
        }
      },
      "required": [
        "recipes"
      ]
    }
  ]
}